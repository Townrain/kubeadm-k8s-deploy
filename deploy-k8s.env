# =============================================================================
# Kubernetes 集群部署 — 环境变量配置
# =============================================================================
# 用法: 填写后运行 bash deploy-k8s-cluster.sh，自动跳过交互输入
# =============================================================================

# ----------------------------- 部署模式 --------------------------------------
# 1 = 在线部署 (从网络下载)
# 2 = 离线部署 (使用 ISO)
DEPLOY_CHOICE="1"

# ----------------------------- 容器运行时 (仅 CentOS Stream 10) ---------------
# containerd = 使用 containerd 内置 CRI (推荐，默认)
# docker     = 使用 Docker Engine + cri-dockerd (可选，仅 CentOS Stream 10)
CONTAINER_RUNTIME="containerd"

# ----------------------------- Master 节点 -----------------------------------
MASTER_HOSTNAME="master"
MASTER_IP="192.168.10.150"
MASTER_IFACE="ens33"
MASTER_PREFIX="24"
MASTER_GW="192.168.10.2"

# ----------------------------- Worker1 节点 (必填) ----------------------------
WORKER1_HOSTNAME="node1"
WORKER1_IP="192.168.10.151"
WORKER1_IFACE="ens33"
WORKER1_PREFIX="24"
WORKER1_GW="192.168.10.2"
WORKER1_USER="root"
WORKER1_PASS=""                  # 需要 sshpass，不填则手动输入

# ----------------------------- Worker2 节点 (可选) ----------------------------
# 留空 WORKER2_IP 则部署 1 Master + 1 Worker 集群
# 填写 WORKER2_IP 则部署 1 Master + 2 Workers 集群
WORKER2_HOSTNAME=""
WORKER2_IP=""
WORKER2_IFACE=""
WORKER2_PREFIX=""
WORKER2_GW=""
WORKER2_USER="root"
WORKER2_PASS=""

# ----------------------------- 网络规划 --------------------------------------
POD_CIDR="172.16.10.0/24"
SVC_CIDR="172.16.32.0/24"
